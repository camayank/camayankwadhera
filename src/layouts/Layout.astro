---
import "../styles/global.css";
import { buttonVariants } from "@/components/ui/button";

const { title, description, current, brand = "personal" } = Astro.props;
const isC4 = brand === "ca4cpa";
// CA4CPA pages show the firm's own identity and a navigation limited to what a CPA firm needs
const c4Nav = [
  { key: "services", href: "/ca4cpa#routes", label: "Services" },
  { key: "how", href: "/ca4cpa#walkthrough", label: "How it works" },
  { key: "inspect", href: "/ca4cpa#inspect", label: "Inspect" },
  { key: "sop", href: "/sop", label: "Procedures" },
  { key: "founder", href: "/profile", label: "Founder" },
];
const personalNav = [
  { key: "about", href: "/about", label: "About" },
  { key: "ventures", href: "/ventures", label: "Ventures" },
  { key: "work", href: "/work", label: "Selected Work" },
  { key: "insights", href: "/insights", label: "Insights" },
  { key: "tools", href: "/tools", label: "Tools" },
  { key: "with-me", href: "/work-with-me", label: "Work With Me" },
];
const nav = isC4 ? c4Nav : personalNav;
const home = isC4
  ? { href: "/ca4cpa", mark: "C4", name: "CA4CPA", note: "Accounting and tax support" }
  : { href: "/", mark: "MW", name: "Mayank Wadhera", note: "Chartered Accountant · Founder" };
const cta = isC4
  ? { href: "/enquire?audience=accounting-us", label: "Request a sample" }
  : { href: "/enquire", label: "Enquire" };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <script is:inline>
      // Mark that scripts run, and guarantee the hero appears even if the motion script never loads.
      document.documentElement.classList.add("js");
      setTimeout(function () { document.documentElement.classList.add("ready"); }, 3000);
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap head-row">
        <a class="brand" href={home.href}>
          <span class="brand-mark">{home.mark}</span>
          <span class="brand-name">{home.name}<small>{home.note}</small></span>
        </a>
        <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
        <nav id="site-nav" class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.key === current ? "page" : undefined}>{item.label}</a>
          ))}
          <a class={buttonVariants({ class: "nav-cta h-9 rounded-lg px-4 no-underline" })} href={cta.href}>{cta.label}</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap foot-grid">
        <div>
          <p class="foot-name">CA Mayank Wadhera</p>
          <p class="foot-line">Domain and process expert. Business strategy and growth architect.</p>
          <p class="foot-line">Gurugram, India</p>
        </div>
        <div>
          <p class="foot-h">Contact</p>
          <a href="/enquire">Send an enquiry</a>
          <a href="/work-with-me">Ways to work together</a>
          <a href="/about">About</a>
        </div>
        <div>
          <p class="foot-h">Professional links</p>
          <a href="https://www.linkedin.com/in/mayankwadhera" rel="noopener">LinkedIn</a>
          <a href="mailto:camayankwadhera@gmail.com">camayankwadhera@gmail.com</a>
          <a href="/profile">Professional profile</a>
          <a href="https://mayankwadhera.com/" rel="noopener">Insights and frameworks</a>
        </div>
        <div>
          <p class="foot-h">Site</p>
          <a href="/privacy">Privacy</a>
          <a href="/work">Selected work</a>
          <a href="/tools">Tax and compliance tools</a>
        </div>
      </div>
      <div class="wrap foot-base">
        <span>© {new Date().getFullYear()} Mayank Wadhera</span>
        <span>camayankwadhera.com</span>
      </div>
    </footer>
    <script>
      import "../scripts/motion.js";

      const toggle = document.querySelector(".nav-toggle");
      const menu = document.getElementById("site-nav");
      toggle?.addEventListener("click", () => {
        const open = menu.classList.toggle("open");
        toggle.setAttribute("aria-expanded", String(open));
      });
    </script>
  </body>
</html>
