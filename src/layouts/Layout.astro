---
import "../styles/global.css";
import { buttonVariants } from "@/components/ui/button";

const { title, description, current } = Astro.props;
const nav = [
  { key: "about", href: "/about", label: "About" },
  { key: "ventures", href: "/ventures", label: "Ventures" },
  { key: "work", href: "/work", label: "Selected Work" },
  { key: "insights", href: "/insights", label: "Insights" },
  { key: "with-me", href: "/work-with-me", label: "Work With Me" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <script is:inline>
      // Mark that scripts run, and guarantee the hero appears even if the motion script never loads.
      document.documentElement.classList.add("js");
      setTimeout(function () { document.documentElement.classList.add("ready"); }, 3000);
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap head-row">
        <a class="brand" href="/">
          <span class="brand-mark">MW</span>
          <span class="brand-name">Mayank Wadhera<small>Chartered Accountant · Founder</small></span>
        </a>
        <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
        <nav id="site-nav" class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={item.key === current ? "page" : undefined}>{item.label}</a>
          ))}
          <a class={buttonVariants({ class: "nav-cta h-9 rounded-lg px-4 no-underline" })} href="/enquire">Enquire</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap foot-grid">
        <div>
          <p class="foot-name">CA Mayank Wadhera</p>
          <p class="foot-line">Finance, compliance technology and employability.</p>
        </div>
        <div>
          <p class="foot-h">Contact</p>
          <a href="/enquire">Send an enquiry</a>
          <a href="/work-with-me">Ways to work together</a>
          <a href="/about#assets">Speaker bio and headshot</a>
        </div>
        <div>
          <p class="foot-h">Professional links</p>
          <span class="confirm">To add: LinkedIn and venture links</span>
        </div>
        <div>
          <p class="foot-h">Site</p>
          <a href="/privacy">Privacy</a>
          <a href="/work#structure">How work is documented</a>
        </div>
      </div>
      <div class="wrap foot-base">
        <span>© {new Date().getFullYear()} Mayank Wadhera</span>
        <span>camayankwadhera.com</span>
      </div>
    </footer>
    <script>
      import "../scripts/motion.js";

      const toggle = document.querySelector(".nav-toggle");
      const menu = document.getElementById("site-nav");
      toggle?.addEventListener("click", () => {
        const open = menu.classList.toggle("open");
        toggle.setAttribute("aria-expanded", String(open));
      });
    </script>
  </body>
</html>
