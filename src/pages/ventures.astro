---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---
<Layout title="Ventures \u2014 CA Mayank Wadhera" description="The ventures founded by Mayank Wadhera across compliance technology, advisory and valuation, global accounting, education and growth." current="ventures">
<section class="hero page-hero" data-no="02">
  <div class="wrap">
    <p class="eyebrow"><b>02</b> Ventures</p>
    <h1 class="mega">Five areas. <em>One builder.</em></h1>
  </div>
</section>

<section class="section">
  <div class="wrap">

    <div class="band reveal"><Icon name="check" /><h2>Compliance technology</h2></div>
    <div class="tiles c2 reveal">
      <a class="tile" id="legal-suvidha" href="/enquire?audience=founder-compliance">
        <span class="vmark">LS</span><strong>Legal Suvidha</strong>
        <div class="tags"><span class="tag">Startup formation</span><span class="tag">Recognition</span><span class="tag">Recurring compliance</span></div>
        <span class="go">Enquire</span>
      </a>
      <a class="tile" id="digicomply" href="/enquire?audience=founder-software">
        <span class="vmark">DC</span><strong>DigiComply</strong>
        <div class="tags"><span class="tag">Workflows</span><span class="tag">Reminders</span><span class="tag">Client collaboration</span></div>
        <span class="go">Product walkthrough</span>
      </a>
    </div>

    <div class="band reveal"><Icon name="scale" /><h2>Advisory and valuation</h2></div>
    <div class="tiles c3 reveal">
      <a class="tile" id="mkw" href="/enquire?audience=founder-advisory">
        <span class="vmark">MKW</span><strong>MKW Advisors</strong>
        <div class="tags"><span class="tag">Valuation</span><span class="tag">ESOP</span><span class="tag">Cross-border</span><span class="tag">Operations</span></div>
        <span class="go">Scope discussion</span>
      </a>
      <a class="tile" id="fuse" href="/enquire?audience=founder-advisory">
        <span class="vmark">FU</span><strong>First Unicorn Startup Evolvers</strong>
        <div class="tags"><span class="tag">Startup ecosystem</span><span class="tag">Venture building</span></div>
        <span class="go">Partnership</span>
      </a>
      <div class="tile" id="amayra">
        <span class="vmark">AF</span><strong>Amayra Fincare</strong>
        <span class="confirm">To add: portfolio profile</span>
      </div>
    </div>

    <div class="band reveal" id="ca4cpa"><Icon name="globe" /><h2>Global accounting and tax</h2></div>
    <div class="tiles c2 reveal">
      <a class="tile" href="/enquire?audience=accounting-us">
        <span class="vmark">C4</span><small>CA4CPA Global LLC · Product</small><strong>US tax Decision Intelligence Platform</strong>
        <div class="tags"><span class="tag">Tax workflows</span><span class="tag">Sample inputs and outputs</span><span class="tag">Reviewer handoff</span><span class="tag">White-label</span></div>
        <div class="steps"><span>Sample</span><span>Demo</span><span>Pilot</span></div>
        <span class="go">Request a demo</span>
      </a>
      <a class="tile" href="/enquire?audience=accounting-intl">
        <span class="vmark">KPO</span><small>CA4CPA KPO Solutions · Delivery</small><strong>Accounting firm delivery support</strong>
        <div class="tags"><span class="tag">Bookkeeping</span><span class="tag">Reconciliations</span><span class="tag">Month-end</span><span class="tag">Workpapers</span><span class="tag">Tax prep support</span></div>
        <div class="steps"><span>Scope</span><span>Batch</span><span>Review</span><span>Repeat</span></div>
        <span class="go">Delivery pilot</span>
      </a>
    </div>

    <div class="actions"><a class="btn solid" href="/ca4cpa">For US CPA firms</a></div>

    <div class="band reveal" id="corpready"><Icon name="cap" /><h2>Talent and employability</h2></div>
    <div class="tiles c3 reveal">
      <div class="tile">
        <span class="vmark">CR</span><strong>CorpReady Academy · CorpReady AI</strong>
        <div class="tags"><span class="tag">Skill diagnostics</span><span class="tag">GCC Ready</span><span class="tag">Job Ready</span><span class="tag">Campus partnerships</span></div>
      </div>
      <a class="tile" href="/enquire?audience=college"><Icon name="columns" /><strong>I lead a college</strong><span class="go">College partnership</span></a>
      <a class="tile" href="/enquire?audience=employer"><Icon name="briefcase" /><strong>I hire talent</strong><span class="go">Employer partnership</span></a>
    </div>

    <div class="band reveal"><Icon name="growth" /><h2>Growth and security</h2></div>
    <div class="tiles c2 reveal">
      <a class="tile" id="growbiz" href="/enquire?audience=founder-growth">
        <span class="vmark">GB</span><strong>GrowBiz Online / GrowBiz10x</strong>
        <div class="tags"><span class="tag">Growth execution</span></div>
        <span class="go">Growth discussion</span>
      </a>
      <div class="tile" id="cybercomply">
        <span class="vmark">CC</span><strong>CyberComply.io</strong>
        <div class="tags"><span class="tag">Security</span><span class="tag">Compliance</span></div>
      </div>
    </div>
    <p class="mt-6"><span class="confirm">To add: each venture's real logo in place of its initials</span></p>
  </div>
</section>
</Layout>
