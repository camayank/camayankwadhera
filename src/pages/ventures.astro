---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---
<Layout title="Ventures — CA Mayank Wadhera" description="The ventures founded by Mayank Wadhera: CA4CPA, Legal Suvidha, MKW Advisors, DigiComply, CorpReady, GrowBiz, First Unicorn and Amayra Fincare." current="ventures">
<section class="hero page-hero">
  <div class="wrap">
    <p class="eyebrow"><b>02</b> Ventures</p>
    <h1 class="mega">Distinct mandates. <em>Shared discipline.</em></h1>
  </div>
</section>

<section class="section">
  <div class="wrap">

    <div class="band reveal" id="ca4cpa"><Icon name="globe" /><h2>Global accounting and tax</h2></div>
    <div class="tiles c2 reveal">
      <a class="tile" href="/ca4cpa">
        <span class="vmark">C4</span><small>Founder, CA4CPA Global LLC · established 2025</small><strong>CA4CPA</strong>
        <div class="tags"><span class="tag">Bookkeeping</span><span class="tag">Month-end</span><span class="tag">Tax preparation support</span><span class="tag">US tax decision platform</span></div>
        <span class="go">For CPA firms</span>
      </a>
      <a class="tile" href="/sop">
        <Icon name="layers" /><strong>How delivery runs</strong>
        <div class="tags"><span class="tag">Set up</span><span class="tag">Run</span><span class="tag">Control</span><span class="tag">Scale</span></div>
        <span class="go">See the procedures</span>
      </a>
    </div>

    <div class="band reveal"><Icon name="check" /><h2>Compliance and regulatory technology</h2></div>
    <div class="tiles c2 reveal">
      <a class="tile" id="legal-suvidha" href="/enquire?audience=founder-compliance">
        <span class="vmark">LS</span><small>Founder · since 2017</small><strong>Legal Suvidha</strong>
        <div class="tags"><span class="tag">Incorporation</span><span class="tag">Recurring compliance</span><span class="tag">Accounting and tax</span></div>
        <span class="go">Enquire</span>
      </a>
      <a class="tile" id="digicomply" href="/enquire?audience=founder-software">
        <span class="vmark">DC</span><small>Founder, DigiComply Solutions Private Limited</small><strong>DigiComply</strong>
        <div class="tags"><span class="tag">Task management</span><span class="tag">Reminders</span><span class="tag">Document workflows</span><span class="tag">Client collaboration</span></div>
        <span class="go">Product walkthrough</span>
      </a>
    </div>

    <div class="band reveal"><Icon name="scale" /><h2>Advisory and valuation</h2></div>
    <div class="tiles c2 reveal">
      <a class="tile" id="mkw" href="/enquire?audience=founder-advisory">
        <span class="vmark">MKW</span><small>Founder</small><strong>MKW Advisors</strong>
        <div class="tags"><span class="tag">Valuation</span><span class="tag">Financial analysis</span><span class="tag">Structuring</span><span class="tag">Strategic advisory</span></div>
        <span class="go">Scope discussion</span>
      </a>
      <div class="tile" id="amayra">
        <span class="vmark">AF</span><small>Founder</small><strong>Amayra Fincare</strong>
        <div class="tags"><span class="tag">Finance</span><span class="tag">Business services</span></div>
      </div>
    </div>

    <div class="band reveal" id="corpready"><Icon name="cap" /><h2>Talent and startups</h2></div>
    <div class="tiles c2 reveal">
      <a class="tile" href="/enquire?audience=college">
        <span class="vmark">CR</span><small>Founder</small><strong>CorpReady</strong>
        <div class="tags"><span class="tag">Practical learning</span><span class="tag">Internships</span><span class="tag">Job readiness</span><span class="tag">Employers</span></div>
        <span class="go">College or employer partnership</span>
      </a>
      <a class="tile" id="fuse" href="/enquire?audience=founder-advisory">
        <span class="vmark">FU</span><small>Founder, First Unicorn Startup Evolvers Private Limited</small><strong>First Unicorn</strong>
        <div class="tags"><span class="tag">Founder support</span><span class="tag">Startup development</span></div>
        <span class="go">Founder partnership</span>
      </a>
    </div>

    <div class="band reveal" id="growbiz"><Icon name="growth" /><h2>Growth</h2></div>
    <div class="tiles c2 reveal">
      <a class="tile" href="/enquire?audience=founder-growth">
        <span class="vmark">GB</span><small>Founder</small><strong>GrowBiz</strong>
        <div class="tags"><span class="tag">Digital visibility</span><span class="tag">Lead generation</span><span class="tag">Execution</span></div>
        <span class="go">Growth discussion</span>
      </a>
      <a class="tile" href="/profile">
        <Icon name="doc" /><strong>All ventures on one page</strong>
        <div class="tags"><span class="tag">Experience</span><span class="tag">Qualifications</span><span class="tag">Ventures</span></div>
        <span class="go">View profile</span>
      </a>
    </div>
  </div>
</section>
</Layout>
