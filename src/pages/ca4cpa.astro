---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { ChecksBeam } from "@/components/kit/ChecksBeam";
import { FrameBeam } from "@/components/kit/FrameBeam";
import { HeroBadge } from "@/components/kit/HeroBadge";
import { HeroDots } from "@/components/kit/HeroDots";

const steps = ["Records in", "Reconciled", "Reviewed", "Your sign-off"];
const docs = ["Bank", "Cards", "Invoices", "Bills", "Payroll", "Receipts"];
// which of the eight rows on the illustrated month-end pack carry a review flag
const rows = [72, 88, 64, 92, 58, 80, 70, 46].map((width, index) => ({ width, flag: [1, 4, 6].includes(index) }));
// lines on the hero's illustrated close pack
const pack = [
  { label: "Bank reconciliation", width: 86, done: true },
  { label: "Card reconciliation", width: 74, done: true },
  { label: "Accruals schedule", width: 62, done: true },
  { label: "Payroll tie-out", width: 80, done: true },
  { label: "Open queries", width: 34, done: false },
];
const credentials = [
  ["CA", "Chartered Accountant · 2011"],
  ["CS", "Company Secretary · 2013"],
  ["CMA", "Cost & Management Accountant · 2016"],
  ["LLB", "Bachelor of Laws · 2023"],
];
---
<Layout
  title="CA4CPA — Accounting and tax support for US CPA firms"
  description="CA4CPA Global LLC: bookkeeping, month-end accounting and tax preparation support for CPA firms, alongside a US tax decision software platform."
  current="services"
  brand="ca4cpa"
>
  <section class="hero hero-visual relative overflow-hidden">
    <HeroDots client:load />
    <div class="wrap relative">
      <div class="hero-split">
        <div>
          <HeroBadge>Technology-first · Professionally qualified</HeroBadge>
          <h1 class="mega" style="font-size:clamp(38px,5.6vw,76px)">Accounting and tax support <em>for US CPA firms.</em></h1>
          <div class="hero-meta">
            <span class="tag">Bookkeeping</span>
            <span class="tag">Month-end accounting</span>
            <span class="tag">Tax preparation support</span>
            <span class="tag">US tax decision platform</span>
          </div>
          <div class="actions">
            <a class="btn solid" href="/enquire?audience=accounting-us">Request a sample close pack</a>
            <a class="btn" href="/enquire?audience=accounting-us">Discuss a paid pilot</a>
          </div>
          <a class="text-route" href="#platform">Explore the US tax decision platform</a>
        </div>
        <figure class="pack-stage" aria-label="Illustration of a reviewed month-end pack">
          <div class="pack">
            <header><strong>Month-end pack</strong><span>Reviewed</span></header>
            {pack.map((line) => (
              <div class="pack-row">
                <span class="pack-label">{line.label}</span>
                <span class="pack-bar"><i style={`width:${line.width}%`}></i></span>
                <em class={line.done ? "ok" : "open"}></em>
              </div>
            ))}
            <footer><span>Prepared</span><span>Reviewed</span><span class="next">Your sign-off</span></footer>
            <FrameBeam client:load />
          </div>
          <figcaption><span class="illus">Illustration</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="strip-label"><div class="wrap">Founder's previous product experience</div></div>
  <section class="proof-strip" aria-label="Founder's previous product experience">
    <div class="wrap proof-row">
      <a href="/work#public"><strong>MCA21</strong><span>Infosys · 2013 – 2015</span></a>
      <a href="/work#public"><strong>GSTN</strong><span>2015 – 2016</span></a>
      <a href="/work#public"><strong>DigiGST</strong><span>EY · 2016 – 2019</span></a>
      <a href="/about"><strong>CA4CPA</strong><span>Established 2025</span></a>
    </div>
  </section>

  <section class="section dark" id="routes">
    <div class="wrap">
      <div class="band"><Icon name="layers" /><h2>Three services, <em>three ways to try them</em></h2></div>
      <div class="lanes reveal">
        <div class="lane"><div><small>Accounting</small><strong>Bookkeeping and month-end</strong></div><div class="steps big"><span>Sample close pack</span><span>Scope call</span><span>Paid pilot month</span></div></div>
        <div class="lane"><div><small>Tax</small><strong>Preparation support</strong></div><div class="steps big"><span>Agreed scope</span><span>Small batch</span><span>Review</span></div></div>
        <div class="lane"><div><small>Software</small><strong>US tax decision platform</strong></div><div class="steps big"><span>Sample workflow</span><span>Demo</span><span>Paid software pilot</span></div></div>
      </div>
    </div>
  </section>

  <!-- Scroll-driven walkthrough. Without scripts or with reduced motion it shows the finished state. -->
  <section class="walk" id="walkthrough" data-walk>
    <div class="wrap walk-grid">
      <div>
        <p class="eyebrow">One month, four stages</p>
        <ol class="walk-steps">
          {steps.map((label, index) => (
            <li><b>0{index + 1}</b><strong>{label}</strong></li>
          ))}
        </ol>
        <p class="walk-note"><span class="illus">Illustration</span></p>
      </div>
      <div class="walk-stage" aria-hidden="true">
        <div class="desk">
          {docs.map((label, index) => <div class="doc" style={`--i:${index}`}>{label}</div>)}
          <div class="sheet">
            <header><span>Month-end pack</span><i>Draft</i></header>
            {rows.map((row) => (
              <div class="row"><span style={`--w:${row.width}%`}></span>{row.flag && <em class="flag"></em>}</div>
            ))}
          </div>
          <aside class="notes"><b>Review notes</b><span></span><span></span><span></span></aside>
          <div class="stamp">Your<br />sign-off</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="inspect">
    <div class="wrap">
      <div class="band reveal"><Icon name="doc" /><h2>Ask us for these <em>before you commit</em></h2></div>
      <div class="tiles c3 reveal">
        <a class="tile" href="/enquire?audience=accounting-us"><Icon name="doc" /><strong>A sample close pack</strong><small>Reconciliation, close checklist, adjustment schedule and reviewer query log</small><span class="go">Request it</span></a>
        <a class="tile" href="/enquire?audience=accounting-us"><Icon name="shield" /><strong>How your data is handled</strong><small>Access, devices, file storage, retention and deletion</small><span class="go">Ask us</span></a>
        <a class="tile" href="/enquire?audience=accounting-us"><Icon name="bolt" /><strong>Where AI is used</strong><small>Which tasks, what data it sees, and who verifies the result</small><span class="go">Ask us</span></a>
        <a class="tile" href="/enquire?audience=accounting-us"><Icon name="screen" /><strong>Software we work in</strong><small>The applications our team operates, and how access works</small><span class="go">Ask us</span></a>
        <a class="tile" href="/enquire?audience=accounting-us"><Icon name="check" /><strong>Scope and exclusions</strong><small>Deliverables, supported work types and what is out of scope</small><span class="go">Ask us</span></a>
        <a class="tile" href="/enquire?audience=accounting-us"><Icon name="scale" /><strong>Commercial terms</strong><small>Pricing basis, pilot scope and exit</small><span class="go">Ask us</span></a>
      </div>
      <div class="actions"><a class="btn" href="/sop">How delivery runs</a></div>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <div class="band reveal"><Icon name="layers" /><h2>Your firm keeps the sign-off</h2></div>
      <ChecksBeam client:visible />
    </div>
  </section>

  <section class="section" id="founder">
    <div class="wrap">
      <div class="founder reveal">
        <img src="/portrait.jpg" alt="Mayank Wadhera" width="1024" height="1536" loading="lazy" />
        <div>
          <p class="eyebrow">Who leads the work</p>
          <h2>CA Mayank Wadhera</h2>
          <div class="tags" style="margin-top:14px"><span class="tag">Founder, CA4CPA Global LLC</span><span class="tag">Infosys · MCA21</span><span class="tag">GSTN</span><span class="tag">EY · DigiGST</span></div>
          <div class="seals" style="margin-top:22px">
            {credentials.map(([short, full]) => <span class="seal">{short}<small>{full}</small></span>)}
          </div>
          <div class="tags"><span class="tag">Registered Valuer · 2024</span><span class="tag">Insolvency Professional · 2024</span><span class="tag">M.Com. · 2014</span></div>
          <div class="actions">
            <a class="btn solid" href="/profile">View full profile</a>
            <a class="btn" href="/about">About the founder</a>
            <a class="btn" href="https://www.linkedin.com/in/mayankwadhera" rel="noopener">LinkedIn</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section tint" id="platform">
    <div class="wrap">
      <div class="band reveal"><Icon name="screen" /><h2>The technology</h2></div>
      <div class="tiles c3 reveal">
        <div class="tile"><Icon name="target" /><small>CA4CPA Global LLC</small><strong>US tax decision software platform</strong><small>For US returns. Shown on a sample workflow before any pilot.</small></div>
        <div class="tile"><Icon name="check" /><small>DigiComply Solutions Private Limited</small><strong>DigiComply</strong><small>Task management, reminders, document workflows and client collaboration for professional firms.</small></div>
        <div class="tile"><Icon name="columns" /><small>2013 – 2019</small><strong>Built on tax-technology experience</strong><small>MCA21 at Infosys, the GSTN platform, and DigiGST and e-way bill management at EY.</small></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="mega">Start with <em>one sample close pack.</em></h2>
      <div class="actions">
        <a class="btn solid" href="/enquire?audience=accounting-us">Request a sample close pack</a>
        <a class="btn" href="/enquire?audience=accounting-intl">Outside the US</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import "../scripts/walkthrough.js";
</script>
