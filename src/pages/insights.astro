---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---
<Layout title="Insights \u2014 CA Mayank Wadhera" description="Writing by Mayank Wadhera on tax and compliance technology, accounting firm operations, valuation and governance, employability and building products." current="insights">
<section class="hero page-hero" data-no="04">
  <div class="wrap">
    <p class="eyebrow"><b>04</b> Insights</p>
    <h1 class="mega">Notes from <em>practice.</em></h1>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <p class="eyebrow">Subjects I work on and write about</p>
    <div class="tiles c5 reveal">
      <div class="tile"><Icon name="check" /><strong>Tax and compliance tech</strong><div class="tags"><span class="tag">GST</span><span class="tag">MCA</span><span class="tag">E-invoicing</span><span class="tag">Rules to SOPs</span></div></div>
      <div class="tile"><Icon name="globe" /><strong>Accounting firm operations</strong><div class="tags"><span class="tag">Offshore delivery</span><span class="tag">US tax review</span><span class="tag">Workpapers</span></div></div>
      <div class="tile"><Icon name="scale" /><strong>Valuation and governance</strong><div class="tags"><span class="tag">ESOPs</span><span class="tag">Transactions</span><span class="tag">Boards</span></div></div>
      <div class="tile"><Icon name="cap" /><strong>Education and employability</strong><div class="tags"><span class="tag">Skills mapping</span><span class="tag">GCC hiring</span><span class="tag">Internships</span></div></div>
      <div class="tile"><Icon name="pen" /><strong>Founder notes</strong><div class="tags"><span class="tag">Building</span><span class="tag">Testing</span><span class="tag">Pilot to recurring</span></div></div>
    </div>
  </div>
</section>

<section class="section tint">
  <div class="wrap">
    <p class="eyebrow">Suggest a topic</p>
    <h2>Got a question worth <em>an article?</em></h2>
    <div class="actions"><a class="btn solid" href="/enquire">Send it</a></div>
  </div>
</section>
</Layout>
