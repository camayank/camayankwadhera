---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

const qualifications = [
  ["CA", "Chartered Accountant", "2011"],
  ["CS", "Company Secretary", "2013"],
  ["M.Com.", "Master of Commerce", "2014"],
  ["CMA", "Cost & Management Accountant", "2016"],
  ["LLB", "Bachelor of Laws", "2023"],
];
---
<Layout title="About — CA Mayank Wadhera" description="Mayank Wadhera is an Indian Chartered Accountant, founder and business strategy advisor based in Gurugram: his journey, qualifications and professional profile." current="about">
<section class="hero hero-visual">
  <div class="wrap">
    <div class="hero-split">
      <div>
        <p class="eyebrow"><b>01</b> About</p>
        <h1 class="mega">Domain expert. <em>Product builder.</em></h1>
        <p class="hero-sub">An Indian Chartered Accountant, founder and business strategy advisor based in Gurugram. I bring together finance, compliance, product design and operating processes to turn complex requirements into practical systems.</p>
        <div class="actions">
          <a class="btn solid" href="/Mayank-Wadhera-Professional-Profile.pdf" download>Download profile (PDF)</a>
          <a class="btn" href="https://www.linkedin.com/in/mayankwadhera" rel="noopener">LinkedIn</a>
        </div>
      </div>
      <figure class="portrait portrait-small">
        <div class="portrait-ph"><img src="/portrait.jpg" alt="Mayank Wadhera" width="1024" height="1536" /></div>
      </figure>
    </div>
  </div>
</section>

<section class="section" id="journey">
  <div class="wrap">
    <p class="eyebrow">My journey</p>
    <ol class="journey reveal">
      <li><span class="j-icon"><Icon name="seal" /></span><strong>Chartered Accountant</strong><small>2011 · finance, law, governance</small></li>
      <li><span class="j-icon"><Icon name="columns" /></span><strong>Infosys · MCA21</strong><small>2013 – 2015 · business analysis</small></li>
      <li><span class="j-icon"><Icon name="doc" /></span><strong>GSTN · EY</strong><small>2015 – 2019 · GST platform and DigiGST</small></li>
      <li><span class="j-icon"><Icon name="blocks" /></span><strong>Founder</strong><small>2017 onward · venture ecosystem</small></li>
    </ol>
  </div>
</section>

<section class="section dark">
  <div class="wrap">
    <p class="eyebrow">Where domain meets product</p>
    <div class="tiles c3 reveal">
      <a class="tile" href="/work#public"><Icon name="columns" /><small>2013 – 2015</small><strong>Infosys · MCA21</strong><small>Business analysis for the corporate regulatory platform: regulatory requirements into functional processes.</small></a>
      <a class="tile" href="/work#public"><Icon name="doc" /><small>2015 – 2016</small><strong>GSTN</strong><small>Business analysis in the GST technology ecosystem, connecting tax requirements with platform workflows.</small></a>
      <a class="tile" href="/work#public"><Icon name="screen" /><small>2016 – 2019</small><strong>EY · DigiGST and EWBMS</strong><small>Product management across GST and e-way bill solutions.</small></a>
    </div>
  </div>
</section>

<section class="section tint" id="qualifications">
  <div class="wrap">
    <p class="eyebrow">Qualifications and professional roles</p>
    <div class="seals reveal">
      {qualifications.map(([short, full, year]) => <span class="seal">{short}<small>{full} · {year}</small></span>)}
    </div>
    <div class="tiles c3 reveal">
      <div class="tile"><Icon name="scale" /><small>2024</small><strong>Registered Valuer</strong><small>Securities or Financial Assets</small></div>
      <div class="tile"><Icon name="loop" /><small>2024</small><strong>Insolvency Professional</strong></div>
      <div class="tile"><Icon name="leaf" /><strong>Additional learning</strong><small>UGC-NET (Commerce); social audit; CSR and ESG; ISO 9001, 14001 and 45001 lead auditor training</small></div>
    </div>
  </div>
</section>

<section class="section" id="teaching">
  <div class="wrap">
    <p class="eyebrow">Speaking and collaboration</p>
    <div class="tiles c4 reveal">
      <div class="tile"><Icon name="globe" /><strong>CPA firm partnerships</strong></div>
      <div class="tile"><Icon name="scale" /><strong>Strategic advisory</strong></div>
      <div class="tile"><Icon name="cap" /><strong>Institutional collaboration</strong></div>
      <div class="tile"><Icon name="mic" /><strong>Speaking</strong></div>
    </div>
    <div class="actions"><a class="btn solid" href="/enquire?audience=speaking">Start a conversation</a></div>
  </div>
</section>

<section class="section tint" id="assets">
  <div class="wrap">
    <p class="eyebrow">For organizers and editors</p>
    <div class="tiles c3 reveal">
      <div class="tile"><Icon name="pen" /><strong>Short bio</strong><small>Mayank Wadhera is an Indian Chartered Accountant, founder and business strategy advisor based in Gurugram. His career spans business analysis at Infosys on MCA21, work on the GSTN platform, and product management at EY on DigiGST and e-way bill management. He now builds ventures across accounting support, regulatory technology, valuation, employability and business growth.</small></div>
      <a class="tile" href="/Mayank-Wadhera-Professional-Profile.pdf" download><Icon name="download" /><strong>Professional profile</strong><small>Three pages: overview, experience, qualifications and ventures</small><span class="go">Download PDF</span></a>
      <a class="tile" href="/portrait.jpg" download="Mayank-Wadhera.jpg"><Icon name="user" /><strong>Headshot</strong><small>Portrait photograph</small><span class="go">Download image</span></a>
    </div>
  </div>
</section>
</Layout>
