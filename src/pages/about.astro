---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---
<Layout title="About \u2014 CA Mayank Wadhera" description="The journey, qualifications, teaching and speaking of Mayank Wadhera, Chartered Accountant, founder and product builder." current="about">
<section class="hero hero-visual">
  <div class="wrap">
    <div class="hero-split">
      <div>
        <p class="eyebrow"><b>01</b> About</p>
        <h1 class="mega">Operator. Accountant. <em>Builder.</em></h1>
      </div>
      <!-- Replace the inner <div class="portrait-ph">…</div> with <img src="/portrait.jpg" alt="Mayank Wadhera"> -->
      <figure class="portrait portrait-small">
        <div class="portrait-ph" role="img" aria-label="Portrait placeholder">
          <span class="portrait-mono">MW</span>
          <span class="confirm">To add: your photo</span>
        </div>
      </figure>
    </div>
  </div>
</section>

<section class="section" id="journey">
  <div class="wrap">
    <p class="eyebrow">My journey</p>
    <ol class="journey reveal">
      <li><span class="j-icon"><Icon name="signal" /></span><strong>Operator</strong><small>Cable operations · customers · execution</small></li>
      <li><span class="j-icon"><Icon name="seal" /></span><strong>Chartered Accountant</strong><small>Finance · law · governance</small></li>
      <li><span class="j-icon"><Icon name="columns" /></span><strong>Product analyst</strong><small>Infosys · GSTN · EY</small></li>
      <li><span class="j-icon"><Icon name="blocks" /></span><strong>Founder</strong><small>Practice · software · education · cross-border</small></li>
    </ol>
    <p class="mt-7"><span class="confirm">To add: a year under each stage</span></p>
  </div>
</section>

<section class="section dark">
  <div class="wrap">
    <p class="eyebrow">Corporate product work</p>
    <div class="tiles c3 reveal">
      <a class="tile" href="/work#public"><Icon name="columns" /><strong>Infosys</strong><small>MCA21 · business analysis</small></a>
      <a class="tile" href="/work#public"><Icon name="doc" /><strong>GSTN</strong><small>GST systems · business analysis</small></a>
      <a class="tile" href="/work#public"><Icon name="screen" /><strong>EY</strong><small>DigiGST · e-way bill product work</small></a>
    </div>
  </div>
</section>

<section class="section tint" id="qualifications">
  <div class="wrap">
    <p class="eyebrow">Qualifications and professional roles</p>
    <div class="seals reveal">
      <span class="seal">CA</span><span class="seal">CS</span><span class="seal">CMA</span><span class="seal">M.Com</span><span class="seal">NET</span><span class="seal">LLB</span>
    </div>
    <div class="tiles c4 reveal">
      <div class="tile"><Icon name="scale" /><strong>Registered Valuer</strong><small>Securities or Financial Assets</small></div>
      <div class="tile"><Icon name="loop" /><strong>Insolvency Professional</strong></div>
      <div class="tile"><Icon name="people" /><strong>Governance and board</strong></div>
      <div class="tile"><Icon name="leaf" /><strong>ISO · Social audit · CSR · ESG</strong></div>
    </div>
    <p class="mt-6"><span class="confirm">To add for each: issuer, date, registration and verification link, engagement entity</span></p>
  </div>
</section>

<section class="section" id="teaching">
  <div class="wrap">
    <p class="eyebrow">Teaching and speaking</p>
    <div class="tiles c3 reveal">
      <div class="tile"><Icon name="book" /><strong>Professional education</strong><small>ICAI and professional bodies</small></div>
      <div class="tile"><Icon name="briefcase" /><strong>Industry training</strong><small>GST and compliance</small></div>
      <div class="tile"><Icon name="cap" /><strong>College sessions</strong><small>Careers and employability</small></div>
    </div>
    <div class="actions"><a class="btn solid" href="/enquire?audience=speaking">Invite me to speak</a></div>
  </div>
</section>

<section class="section tint" id="assets">
  <div class="wrap">
    <p class="eyebrow">Bio and headshot</p>
    <div class="tiles c3 reveal">
      <div class="tile"><Icon name="pen" /><strong>Short bio</strong><small>Mayank Wadhera is a Chartered Accountant, founder and product builder working across finance, compliance technology and employability. He has worked on MCA21 at Infosys, GST systems at GSTN and DigiGST at EY, and founded DigiComply, CA4CPA and CorpReady.</small></div>
      <div class="tile"><Icon name="download" /><strong>Full bio and timeline</strong><span class="confirm">To add: PDF</span></div>
      <div class="tile"><Icon name="user" /><strong>Headshot</strong><span class="confirm">To add: approved photo</span></div>
    </div>
  </div>
</section>
</Layout>
