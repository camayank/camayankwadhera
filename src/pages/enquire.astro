---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Enquire — CA Mayank Wadhera" description="Start a conversation with Mayank Wadhera: CPA firm partnerships, strategic advisory, institutional collaboration and speaking enquiries." current="enquire">
<section class="hero page-hero">
  <div class="wrap">
    <p class="eyebrow">Start a conversation</p>
    <h1 class="mega">Tell me who you are and <em>what you need.</em></h1>
    <div class="hero-meta">
      <a class="tag" href="mailto:camayankwadhera@gmail.com">camayankwadhera@gmail.com</a>
      <a class="tag" href="tel:+918130645164">+91 81306 45164</a>
      <a class="tag" href="https://www.linkedin.com/in/mayankwadhera" rel="noopener">LinkedIn</a>
      <span class="tag">Gurugram, Haryana, India</span>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <form class="form" id="enquiry">
      <div class="full">
        <label for="audience">I am</label>
        <select id="audience" name="audience" required>
          <option value="">Choose one</option>
          <optgroup label="Accounting firms">
            <option value="accounting-us">A US CPA firm</option>
            <option value="accounting-intl">An accounting practice outside the US</option>
          </optgroup>
          <optgroup label="Founders and business owners">
            <option value="founder-compliance">Looking for incorporation or recurring compliance</option>
            <option value="founder-software">Looking for workflow software for a professional firm</option>
            <option value="founder-advisory">Looking for valuation, structuring or strategic advisory</option>
            <option value="founder-growth">Looking for visibility and lead generation</option>
          </optgroup>
          <optgroup label="Others">
            <option value="board">A board member or investor</option>
            <option value="college">A college leader</option>
            <option value="employer">An employer</option>
            <option value="speaking">An event organizer or professional body</option>
          </optgroup>
        </select>
        <p class="form-note" id="route-hint" aria-live="polite" style="margin:10px 0 0"></p>
      </div>
      <div><label for="name">Name</label><input id="name" name="name" autocomplete="name" required /></div>
      <div><label for="org">Organization</label><input id="org" name="organization" autocomplete="organization" /></div>
      <div class="full"><label for="country">Country</label><input id="country" name="country" autocomplete="country-name" required /></div>
      <div class="full"><label for="need">What do you need?</label><textarea id="need" name="need" required placeholder="For speaking: topic, audience, dates and format. For firms: the work type and rough volume."></textarea></div>
      <div class="full">
        <label for="next">Preferred next step</label>
        <select id="next" name="next_step">
          <option>A call</option>
          <option>A demo</option>
          <option>Sample work or output</option>
          <option>A proposal</option>
          <option>A reply by email</option>
        </select>
      </div>
      <div class="full">
        <button class="btn solid" type="submit">Write the email</button>
        <p class="form-note" style="margin-top:14px">This opens your own email app with the message filled in, ready for you to send. Nothing is stored on this site. See the <a href="/privacy">privacy page</a>.</p>
      </div>
    </form>
  </div>
</section>
</Layout>

<script>
  import "../scripts/enquiry.js";
</script>
