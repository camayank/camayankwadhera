---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { getCollection } from "astro:content";

const recent = (await getCollection("workLog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const fmt = new Intl.DateTimeFormat("en-GB", { month: "long", year: "numeric" });
---
<Layout title="Selected Work \u2014 CA Mayank Wadhera" description="Selected work by Mayank Wadhera: MCA21, GSTN, EY DigiGST, founder-built products and client case studies, each documented with role and evidence." current="work">
<section class="hero page-hero" data-no="03">
  <div class="wrap">
    <p class="eyebrow"><b>03</b> Selected work</p>
    <h1 class="mega">Role first. <em>Evidence next.</em></h1>
  </div>
</section>

<section class="section" id="public">
  <div class="wrap">
    <p class="eyebrow">Employer work · public digital infrastructure</p>
    <div class="plates reveal">
      <article class="plate"><div><span>Infosys</span><strong>MCA21</strong></div><div class="tags"><span class="tag">Business analysis</span><span class="tag">Workflow contributions</span></div></article>
      <article class="plate"><div><span>GST Network</span><strong>GSTN</strong></div><div class="tags"><span class="tag">Requirements</span><span class="tag">Rules into system behaviour</span></div></article>
      <article class="plate"><div><span>EY</span><strong>DigiGST</strong></div><div class="tags"><span class="tag">Product requirements</span><span class="tag">Workflow design</span><span class="tag">E-way bill</span><span class="tag">Training</span></div></article>
    </div>
    <p class="mt-6"><span class="confirm">To add: role dates, references and text approved for publication</span></p>
  </div>
</section>

<section class="section tint" id="founder">
  <div class="wrap">
    <p class="eyebrow">Founder work · products and operations</p>
    <div class="tiles c4 reveal">
      <a class="tile" href="/ventures#legal-suvidha"><span class="vmark">LS</span><strong>Legal Suvidha</strong><small>Scaling recurring compliance delivery</small></a>
      <a class="tile" href="/ventures#digicomply"><span class="vmark">DC</span><strong>DigiComply</strong><small>Obligations into trackable workflows</small></a>
      <a class="tile" href="/ventures#ca4cpa"><span class="vmark">C4</span><strong>CA4CPA</strong><small>The US tax decision platform</small></a>
      <a class="tile" href="/ventures#corpready"><span class="vmark">CR</span><strong>CorpReady AI</strong><small>Courses and careers mapped to skills</small></a>
    </div>
  </div>
</section>

<section class="section" id="clients">
  <div class="wrap">
    <p class="eyebrow">Client engagements · case studies</p>
    <div class="tiles c4 reveal">
      <div class="tile"><Icon name="box" /><strong>UAE inventory visibility</strong><div class="tags"><span class="tag">Stock</span><span class="tag">Transfers</span><span class="tag">Returns</span></div></div>
      <div class="tile"><Icon name="globe" /><strong>Cross-border advisory</strong><div class="tags"><span class="tag">Jurisdictions</span><span class="tag">Decision support</span></div></div>
      <div class="tile"><Icon name="scale" /><strong>Valuation and transactions</strong></div>
      <div class="tile"><Icon name="cap" /><strong>Campus pilots and training</strong></div>
    </div>
    <p class="mt-6"><span class="confirm">To add: client-approved or anonymized outcomes for each</span></p>
  </div>
</section>

{recent.length > 0 && (
<section class="section tint" id="recent">
  <div class="wrap">
    <p class="eyebrow">Recent work · published with client approval</p>
    <ol class="log recent-log reveal">
      {recent.map((entry) => (
        <li class="log-entry">
          <div class="log-meta">
            <time datetime={entry.data.date.toISOString().slice(0, 10)}>{fmt.format(entry.data.date)}</time>
            <span>{entry.data.venture}</span>
          </div>
          <div class="log-body">
            <h2><a href={`/work/log#${entry.id}`}>{entry.data.title}</a></h2>
            <p class="log-summary">{entry.data.summary}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="actions"><a class="btn" href="/work/log">Full work log</a></div>
  </div>
</section>
)}

<section class="section dark" id="structure">
  <div class="wrap">
    <p class="eyebrow">Every case study answers six questions</p>
    <div class="structure reveal">
      <div><b>Context</b><span>What problem existed?</span></div>
      <div><b>Role</b><span>What was I responsible for?</span></div>
      <div><b>Contribution</b><span>What did I build?</span></div>
      <div><b>Outcome</b><span>What changed?</span></div>
      <div><b>Evidence</b><span>What can you verify?</span></div>
      <div><b>Next step</b><span>Where to go from here?</span></div>
    </div>
  </div>
</section>
</Layout>
