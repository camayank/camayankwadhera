---
import Layout from "../../layouts/Layout.astro";
import { Reminders } from "../../components/tools/Reminders";
---
<Layout title="Advance tax due dates and reminders for Tax Year 2026-27 — CA Mayank Wadhera" description="The advance tax instalment dates for Tax Year 2026-27 as calendar entries with alerts, for Google Calendar, Apple Calendar and Outlook." current="tools">
<section class="hero page-hero t-hero">
  <div class="wrap">
    <p class="eyebrow"><a href="/tools">Tools</a> · Due-date reminders</p>
    <h1>Four dates. <em>None missed.</em></h1>
    <p class="lede">The instalment dates for Tax Year 2026-27, ready for your calendar with alerts ahead of each one. If you have used the calculator, each entry carries your own amount.</p>
  </div>
</section>
<section class="section t-section">
  <div class="wrap">
    <Reminders client:load />
    <noscript><p>This tool needs JavaScript, because it does its arithmetic in your browser and sends nothing to a server.</p></noscript>
  </div>
</section>
</Layout>
