---
import Layout from "../../layouts/Layout.astro";
import { AdvanceTaxCalculator } from "../../components/tools/AdvanceTaxCalculator";
---
<Layout title="Advance tax calculator for Tax Year 2026-27 — CA Mayank Wadhera" description="Work out Indian advance tax for Tax Year 2026-27: tax for the year, the amount due on 15 June, 15 September, 15 December and 15 March, and interest for late payment. Runs in your browser." current="tools">
<section class="hero page-hero t-hero">
  <div class="wrap">
    <p class="eyebrow"><a href="/tools">Tools</a> · Advance tax calculator</p>
    <h1>What to pay, <em>and by when.</em></h1>
    <p class="lede">Enter your income for Tax Year 2026-27. You get the tax for the year, the amount due on each instalment date, and the interest that a missed date would cost.</p>
  </div>
</section>
<section class="section t-section">
  <div class="wrap">
    <AdvanceTaxCalculator client:load />
    <noscript><p>This tool needs JavaScript, because it does its arithmetic in your browser and sends nothing to a server.</p></noscript>
  </div>
</section>
</Layout>
