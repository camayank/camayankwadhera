---
import Layout from "../../layouts/Layout.astro";
import { Reconcile } from "../../components/tools/Reconcile";
---
<Layout title="Check your AIS or Form 26AS against your records — CA Mayank Wadhera" description="Compare the income and TDS in your AIS or Form 26AS with your own records, party by party. Find amounts that differ and entries that are missing. Nothing leaves your browser." current="tools">
<section class="hero page-hero t-hero">
  <div class="wrap">
    <p class="eyebrow"><a href="/tools">Tools</a> · Tax statement check</p>
    <h1>Your statement against <em>your records.</em></h1>
    <p class="lede">Paste the rows from your AIS or Form 26AS on one side and your own records on the other. The check groups them by party and shows what differs and what is missing on either side.</p>
  </div>
</section>
<section class="section t-section">
  <div class="wrap">
    <Reconcile client:load />
    <noscript><p>This tool needs JavaScript, because it does its arithmetic in your browser and sends nothing to a server.</p></noscript>
  </div>
</section>
</Layout>
