---
import Layout from "../../layouts/Layout.astro";
import { ForecastPlanner } from "../../components/tools/ForecastPlanner";
---
<Layout title="Advance tax what-if planner — CA Mayank Wadhera" description="See what a share sale, an exit, a dividend or a bonus does to your Indian advance tax for Tax Year 2026-27, instalment by instalment, before it happens." current="tools">
<section class="hero page-hero t-hero">
  <div class="wrap">
    <p class="eyebrow"><a href="/tools">Tools</a> · What-if planner</p>
    <h1>Test it <em>before it happens.</em></h1>
    <p class="lede">Add a share sale, a dividend or a bonus you expect. See what it does to the tax for the year and to each remaining instalment, set against your current position.</p>
  </div>
</section>
<section class="section t-section">
  <div class="wrap">
    <ForecastPlanner client:load />
    <noscript><p>This tool needs JavaScript, because it does its arithmetic in your browser and sends nothing to a server.</p></noscript>
  </div>
</section>
</Layout>
