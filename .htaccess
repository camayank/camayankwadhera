# camayankwadhera.com — static site (replaces the WordPress rewrite rules)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # one address per page: https, no www
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://camayankwadhera.com%{REQUEST_URI} [R=301,L]
</IfModule>

# old WordPress addresses go to the closest new page
RedirectMatch 301 ^/(others|producer-company|nidhi-company|fema|ngo|rbi|international-taxation)/?$ /work-with-me/
RedirectMatch 301 ^/2023/03/08/credit-gap-india/?$ /insights/
RedirectMatch 301 ^/(wp-admin|wp-login\.php|feed)/?.*$ /

# built assets have unique names, so browsers may keep them for a year
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
